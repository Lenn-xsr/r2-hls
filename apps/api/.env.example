# App
APP_ENV=dev
APP_NAME=r2-hls-api
PORT=4000
TRUST_PROXY_HOPS=1
MONGO_URI=

# Redis (BullMQ queue) — prefer a dedicated instance via REDIS_QUEUE_URL;
# otherwise host/port/password + a separate DB index/prefix are used.
REDIS_QUEUE_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=1
REDIS_QUEUE_PREFIX=bull

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the cdn-worker (e.g. https://media.example.com)
R2_PUBLIC_URL=
# Only needed for cache purges on image uploads
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Signed URLs (private/* per-file access via cdn-worker) — must match cdn-worker SIGNED_URL_SECRET
SIGNED_URL_SECRET=

# HLS delivery (prefix tokens for /v/* via cdn-worker) — must match cdn-worker HLS_TOKEN_SECRET
HLS_TOKEN_SECRET=
HLS_TOKEN_TTL_SECONDS=1800
HLS_TOKEN_BUCKET_SECONDS=300

# Video ingestion (shared secret sent in the Authorization header)
VIDEO_INGEST_SECRET=

# Observability (optional)
DATADOG_KEY=

# Google Secret Manager (optional, only when APP_ENV=prod)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
