# App
APP_ENV=dev
APP_NAME=r2-hls-worker

# Mongo
MONGO_URI=

# Redis (BullMQ queue) — prefer a dedicated instance via REDIS_QUEUE_URL;
# otherwise host/port/password + a separate DB index/prefix are used.
REDIS_QUEUE_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=1
REDIS_QUEUE_PREFIX=bull

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Video pipeline
VIDEO_MAX_DURATION_SECONDS=90
WORKER_CONCURRENCY=1
# Encoder threads per job (WORKER_CONCURRENCY * FFMPEG_THREADS ~= cores; 0 = auto)
FFMPEG_THREADS=4

# Observability (optional)
DATADOG_KEY=

# Google Secret Manager (optional, only when APP_ENV=prod)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
