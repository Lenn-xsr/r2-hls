{
  "name": "@r2-hls/worker",
  "version": "0.0.1",
  "description": "HLS transcoding worker: ffmpeg fMP4/CMAF ladder uploaded to Cloudflare R2",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "prod": "node dist/src/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@r2-hls/config": "workspace:*",
    "@r2-hls/contracts": "workspace:*",
    "@r2-hls/database": "workspace:*",
    "@r2-hls/logger": "workspace:*",
    "bullmq": "^5.78.0",
    "ioredis": "^5.8.0",
    "mime-types": "^3.0.2",
    "mongoose": "^8.24.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@r2-hls/eslint-config": "workspace:*",
    "@r2-hls/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
