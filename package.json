{
  "name": "r2-hls",
  "version": "0.0.1",
  "description": "Self-hosted adaptive video streaming on Cloudflare R2: presigned uploads, an ffmpeg HLS worker and a token-gated edge Worker",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --filter=@r2-hls/api --filter=@r2-hls/worker",
    "dev:api": "turbo run dev --filter=@r2-hls/api",
    "dev:worker": "turbo run dev --filter=@r2-hls/worker",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@r2-hls/api",
    "build:worker": "turbo run build --filter=@r2-hls/worker",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "turbo": "^2.8.1"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    }
  }
}
